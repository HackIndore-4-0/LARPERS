{
  "name": "@campus-access/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "import:osm": "tsx src/osm/import.ts",
    "verify:live": "tsx src/verify-live.ts"
  },
  "dependencies": {
    "@campus-access/shared": "workspace:*",
    "argon2": "^0.44.0",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.2.5",
    "file-type": "^21.0.0",
    "jose": "^6.1.0",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/geojson": "^7946.0.16",
    "@types/multer": "^2.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
