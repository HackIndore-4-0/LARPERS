# Local development must use the resolved Railway public TCP URL, never a ${{...}} reference.
DATABASE_URL=postgresql://USER:PASSWORD@PUBLIC_PROXY_HOST:PUBLIC_PROXY_PORT/DB_NAME
WEB_ORIGIN=http://localhost:5173
EDITOR_EMAIL=editor@example.invalid
EDITOR_PASSWORD=replace-with-private-strong-password
EDITOR_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
PORT=3001
